# Supabase 연결 정보 (나중에 실제 값으로 채워서 .env.local 로 저장하세요)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 사이트 브랜드 (비워두면 PM EDU / 수학으로 동작)
NEXT_PUBLIC_SITE_SUBJECT=
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_TAGLINE=

# 문의 이메일 (비워두면 info@pmedu4u.com)
NEXT_PUBLIC_CONTACT_EMAIL=

# 다른 과목 사이트로 보내는 링크 (둘 다 채워야 헤더에 표시됩니다)
# 수학 사이트에는 영어 주소를, 영어 사이트에는 수학 주소를 넣습니다.
NEXT_PUBLIC_PARTNER_SITE_URL=
NEXT_PUBLIC_PARTNER_SITE_LABEL=

# 왓츠앱 상담 버튼에 쓸 번호 (국가번호 포함, 숫자만)
# 예: 한국 010-1234-5678 -> 821012345678
# 비워두면 상담 버튼이 표시되지 않습니다.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# 메일 발송 (Resend). 관리자 메일 보내기 기능에 필요.
# RESEND_API_KEY 는 Resend 대시보드 > API Keys 에서 발급.
# NEXT_PUBLIC_ 접두어 없이(서버 전용) 넣어야 안전합니다.
RESEND_API_KEY=
# 보내는 사람 표기. Resend 에서 인증한 도메인이어야 합니다.
MAIL_FROM=PM EDU <noreply@pmedu4u.com>

# 계정 삭제(회원 탈퇴)에 필요. Supabase 대시보드 > Project Settings > API >
# service_role 키. 절대 공개하면 안 되고, NEXT_PUBLIC_ 접두어 없이 서버에만 둡니다.
SUPABASE_SERVICE_ROLE_KEY=

# PDF·이미지에서 문제 추출(Gemini). Google AI Studio 에서 발급.
# NEXT_PUBLIC_ 접두어 없이 서버 전용.
GEMINI_API_KEY=

